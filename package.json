{
  "name": "shape-forge",
  "version": "0.1.0",
  "description": "A browser-based vector editor that exports SVG, PNG, and CSS clip-path, built with Paper.js, React, and TypeScript",
  "type": "module",
  "license": "MIT",
  "author": "Shape Forge Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/newjordan/shape-forge-css.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "vector-graphics",
    "svg-editor",
    "paper-js",
    "image-tracing",
    "marching-squares",
    "react",
    "typescript",
    "canvas"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "paper": "^0.12.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
